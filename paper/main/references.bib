@Article{engproc2024079052,
  AUTHOR = {Speiser, Ferenc and Szalay, István and Fodor, Dénes},
  TITLE = {Embedded System Simulation Using Renode},
  JOURNAL = {Engineering Proceedings},
  VOLUME = {79},
